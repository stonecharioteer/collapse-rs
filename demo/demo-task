#!/bin/sh
set -eu

case "${1:-}" in
  format)
    printf '\033[1;36mFormatting workspace...\033[0m\n'
    sleep 0.4
    printf '\033[32m✓ 24 files formatted\033[0m\n'
    ;;

  test)
    printf '\033[1;36mrunning 3 tests\033[0m\n'
    sleep 0.3
    printf 'test command_editor ... \033[32mok\033[0m\n'
    sleep 0.3
    printf 'test ansi_colors   ... \033[32mok\033[0m\n'
    sleep 0.3
    printf 'test output_search ... \033[32mok\033[0m\n'
    printf '\n\033[32mtest result: 3 passed; 0 failed\033[0m\n'
    ;;

  bundle)
    printf '\033[1;35mCreating release bundle...\033[0m\n'
    sleep 0.5
    printf 'collapse-linux     1.4 MB\n'
    printf 'collapse-macos     1.3 MB\n'
    printf 'collapse-windows   1.5 MB\n'
    printf '\033[32m✓ checksums verified\033[0m\n'
    ;;

  *)
    printf 'usage: demo-task {format|test|bundle}\n' >&2
    exit 2
    ;;
esac
